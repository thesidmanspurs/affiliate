# Postgres (schema riêng "affiliate" trong cùng DB, hoặc DB riêng khi tách hạ tầng)
DATABASE_URL="postgresql://user:password@localhost:5432/affiliate?schema=affiliate"

# Secret JWT riêng cho affiliate platform - KHÔNG dùng chung với bất kỳ product nào
AFFILIATE_JWT_SECRET="change-me-to-a-long-random-string"
AFFILIATE_JWT_EXPIRES_IN="7d"

PORT=4100
CORS_ORIGIN="http://localhost:3100"
